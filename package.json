{
    "name": "paragraph-swipe",
    "version": "1.0.0",
    "description": "Swipe right over a paragraph in the Obsidian editor to move it to the end of another note.",
    "main": "main.js",
    "scripts": {
        "dev": "node esbuild.config.mjs",
        "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
        "typecheck": "tsc --noEmit",
        "lint": "eslint ."
    },
    "keywords": [],
    "author": "",
    "license": "MIT",
    "devDependencies": {
        "@eslint/js": "^9.17.0",
        "@types/node": "^22.10.2",
        "builtin-modules": "^4.0.0",
        "esbuild": "^0.24.2",
        "eslint": "^9.17.0",
        "eslint-plugin-obsidianmd": "^0.1.0",
        "obsidian": "latest",
        "tslib": "^2.8.1",
        "typescript": "^5.6.3",
        "typescript-eslint": "^8.18.1"
    }
}